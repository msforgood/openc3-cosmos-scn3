  {
    "schemaVersion": 1,
    "id": "qemu-psp-mm-indirect-write",
    "version": "1.0.0",
    "name": "QEMU MM indirect payload write",
    "description": "MM finds the writable PAYLOAD_PULSE_APP module and pointer slot. A direct write to protected PAYLOAD_CTRL_APP is denied; changing one permitted pointer byte redirects a normal pulse to the controller mode byte. Observe its fault, acknowledged halt and APP_ERROR exit while the pulse app stays alive.",
    "supportedTargets": [
      "CFS-1_QEMU"
    ],
    "timeoutSec": 120,
    "steps": [
      {
        "id": "baseline",
        "type": "pspPhase",
        "phase": "baseline"
      },
      {
        "id": "map",
        "type": "pspPhase",
        "phase": "map"
      },
      {
        "id": "deny-direct-write",
        "type": "pspPhase",
        "phase": "deny-direct-write"
      },
      {
        "id": "pause",
        "type": "pspPhase",
        "phase": "pause"
      },
      {
        "id": "read-pointer",
        "type": "pspPhase",
        "phase": "read-pointer"
      },
      {
        "id": "write-pointer-byte",
        "type": "pspPhase",
        "phase": "write-pointer-byte"
      },
      {
        "id": "verify-pointer",
        "type": "pspPhase",
        "phase": "verify-pointer"
      },
      {
        "id": "resume",
        "type": "pspPhase",
        "phase": "resume"
      },
      {
        "id": "observe-fault",
        "type": "pspPhase",
        "phase": "observe-fault"
      },
      {
        "id": "confirm-es-exit",
        "type": "pspPhase",
        "phase": "confirm-es-exit"
      },
      {
        "id": "confirm-pulse",
        "type": "pspPhase",
        "phase": "confirm-pulse"
      }
    ],
    "telemetryItems": [
      {
        "packet": "MM_DEBUG",
        "item": "STATUS"
      },
      {
        "packet": "MM_DEBUG",
        "item": "POINTER_SLOT"
      },
      {
        "packet": "PAYLOAD_PULSE_STATE",
        "item": "STATE"
      },
      {
        "packet": "PAYLOAD_PULSE_STATE",
        "item": "FEED_TARGET_ADDRESS"
      },
      {
        "packet": "PAYLOAD_CTRL_STATE",
        "item": "FAULT"
      },
      {
        "packet": "PAYLOAD_CTRL_STATE",
        "item": "HALT_ACKED"
      }
    ],
    "successCriteria": {
      "type": "allStepsSucceeded",
      "requireFreshTelemetry": true
    }
  },
