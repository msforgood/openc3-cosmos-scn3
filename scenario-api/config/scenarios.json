[
  {
    "schemaVersion": 1,
    "id": "cs-crc-key-oracle",
    "version": "1.0.1",
    "name": "01. CS 1바이트 CRC 키 복원",
    "description": "Recover the X-band lab key with 16 one-byte CS CRC requests, then authenticate a fresh X-band frame and reveal its encrypted lab flag.",
    "supportedTargets": [
      "CFS-1_QEMU",
      "CFS-1_BBB"
    ],
    "timeoutSec": 120,
    "steps": [
      {
        "id": "locate-key",
        "type": "resolveAddress",
        "timeoutSec": 10,
        "pollIntervalSec": 0.5
      },
      {
        "id": "recover-byte-00",
        "type": "crcByte",
        "offset": 0,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-01",
        "type": "crcByte",
        "offset": 1,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-02",
        "type": "crcByte",
        "offset": 2,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-03",
        "type": "crcByte",
        "offset": 3,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-04",
        "type": "crcByte",
        "offset": 4,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-05",
        "type": "crcByte",
        "offset": 5,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-06",
        "type": "crcByte",
        "offset": 6,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-07",
        "type": "crcByte",
        "offset": 7,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-08",
        "type": "crcByte",
        "offset": 8,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-09",
        "type": "crcByte",
        "offset": 9,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-10",
        "type": "crcByte",
        "offset": 10,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-11",
        "type": "crcByte",
        "offset": 11,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-12",
        "type": "crcByte",
        "offset": 12,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-13",
        "type": "crcByte",
        "offset": 13,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-14",
        "type": "crcByte",
        "offset": 14,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "recover-byte-15",
        "type": "crcByte",
        "offset": 15,
        "timeoutSec": 6,
        "pollIntervalSec": 0.25
      },
      {
        "id": "verify-xband-frame",
        "type": "verifyXbandFrame",
        "timeoutSec": 8,
        "pollIntervalSec": 0.25
      }
    ],
    "telemetryItems": [
      {
        "packet": "XKEY_HK",
        "item": "KEY_ADDRESS"
      },
      {
        "packet": "XKEY_HK",
        "item": "KEY_LENGTH"
      },
      {
        "packet": "XKEY_HK",
        "item": "CHANNEL_READY"
      },
      {
        "packet": "CS_HK",
        "item": "LAST_ONE_SHOT_ADDRESS"
      },
      {
        "packet": "CS_HK",
        "item": "LAST_ONE_SHOT_CHECKSUM"
      },
      {
        "packet": "CS_HK",
        "item": "COMMAND_COUNTER"
      },
      {
        "packet": "CS_HK",
        "item": "COMMAND_ERROR_COUNTER"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "MAGIC"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "IV_PREFIX"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "COUNTER"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "CIPHERTEXT_0"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "CIPHERTEXT_1"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "CIPHERTEXT_2"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "CIPHERTEXT_3"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "TAG_0"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "TAG_1"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "TAG_2"
      },
      {
        "packet": "XBAND_FRAME",
        "item": "TAG_3"
      }
    ],
    "successCriteria": {
      "type": "allStepsSucceeded",
      "requireFreshTelemetry": true
    }
  },
  {
    "schemaVersion": 1,
    "id": "tc-log-photo-traversal",
    "version": "1.0.0",
    "name": "02. TC 로그 사진 경로 변경",
    "description": "Record commands in an onboard TC log, seal and read the file, then use a camera filename containing ../ to replace that closed log with a fixed image. Ground command history remains separate.",
    "supportedTargets": [
      "CFS-1_QEMU",
      "CFS-1_BBB"
    ],
    "timeoutSec": 120,
    "steps": [
      {
        "id": "seal-baseline",
        "type": "tcLogPhase",
        "phase": "seal-baseline"
      },
      {
        "id": "record-normal",
        "type": "tcLogPhase",
        "phase": "record-normal"
      },
      {
        "id": "seal-target",
        "type": "tcLogPhase",
        "phase": "seal-target"
      },
      {
        "id": "read-before",
        "type": "tcLogPhase",
        "phase": "read-before"
      },
      {
        "id": "overwrite-log",
        "type": "tcLogPhase",
        "phase": "overwrite-log"
      },
      {
        "id": "read-after",
        "type": "tcLogPhase",
        "phase": "read-after"
      },
      {
        "id": "confirm-continuity",
        "type": "tcLogPhase",
        "phase": "confirm-continuity"
      }
    ],
    "telemetryItems": [
      {
        "packet": "CI_LOG_STATUS",
        "item": "RESULT"
      },
      {
        "packet": "CI_LOG_CHUNK",
        "item": "RESULT"
      },
      {
        "packet": "TC_CAMERA_RESULT",
        "item": "STATUS"
      }
    ],
    "successCriteria": {
      "type": "allStepsSucceeded",
      "requireFreshTelemetry": true
    }
  },
  {
    "schemaVersion": 1,
    "id": "psp-mm-indirect-write",
    "version": "2.0.0",
    "name": "03. MM 포인터 변경",
    "description": "MM locates PAYLOAD_DATA_APP and permits writes only within its loaded module. A four-byte write changes its data-buffer pointer to an unmapped guard page. After the sampling app resumes, the host observer confirms that the same cFS process exits with SIGSEGV.",
    "supportedTargets": [
      "CFS-1_QEMU",
      "CFS-1_BBB"
    ],
    "timeoutSec": 120,
    "steps": [
      {
        "id": "baseline",
        "type": "pspPhase",
        "phase": "baseline"
      },
      {
        "id": "map",
        "type": "pspPhase",
        "phase": "map"
      },
      {
        "id": "deny-direct-write",
        "type": "pspPhase",
        "phase": "deny-direct-write"
      },
      {
        "id": "pause",
        "type": "pspPhase",
        "phase": "pause"
      },
      {
        "id": "read-pointer",
        "type": "pspPhase",
        "phase": "read-pointer"
      },
      {
        "id": "write-pointer",
        "type": "pspPhase",
        "phase": "write-pointer"
      },
      {
        "id": "verify-pointer",
        "type": "pspPhase",
        "phase": "verify-pointer"
      },
      {
        "id": "resume",
        "type": "pspPhase",
        "phase": "resume"
      },
      {
        "id": "confirm-sigsegv",
        "type": "pspPhase",
        "phase": "confirm-sigsegv"
      }
    ],
    "telemetryItems": [
      {
        "packet": "MM_DEBUG",
        "item": "STATUS"
      },
      {
        "packet": "MM_DEBUG",
        "item": "POINTER_SLOT"
      },
      {
        "packet": "PAYLOAD_DATA_STATE",
        "item": "STATE"
      },
      {
        "packet": "PAYLOAD_DATA_STATE",
        "item": "WRITE_TARGET_ADDRESS"
      },
      {
        "packet": "PAYLOAD_DATA_STATE",
        "item": "GUARD_ADDRESS"
      },
      {
        "packet": "PAYLOAD_DATA_STATE",
        "item": "SAMPLE_COUNT"
      }
    ],
    "successCriteria": {
      "type": "allStepsSucceeded",
      "requireFreshTelemetry": false
    }
  }
]
