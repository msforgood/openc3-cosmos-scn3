[Unit]
Description=cFS payload data scenario on BeagleBone Black
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/cfs-bbb
ExecStart=/home/debian/cfs-bbb/core-cpu1
Restart=no
KillMode=control-group
LimitRTPRIO=99
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
